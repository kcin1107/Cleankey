    "loginItem.changeError": {
      "comment": "Error shown when changing the login item fails. The argument is the system error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't change Open at Login: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bei der Anmeldung öffnen“ konnte nicht geändert werden: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier « Ouvrir avec la session » : %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cambiar «Abrir al iniciar sesión»: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改“登录时打开”：%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile modificare “Apri al login”: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось изменить параметр «Открывать при входе»: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ログイン時に開く」を変更できませんでした：%@"
          }
        }
      }
    },
    "permissions.missing.one": {
      "comment": "Shown when one required permission is missing. The argument is its localized name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ not granted. Enable below, then reopen Cleankey."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht erlaubt. Unten aktivieren und Cleankey anschließend erneut öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation « %@ » n’a pas été accordée. Autorisez-la ci-dessous, puis rouvrez Cleankey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha concedido el permiso «%@». Actívalo abajo y vuelve a abrir Cleankey."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授予“%@”权限。请在下方启用，然后重新打开 Cleankey。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorizzazione “%@” non è stata concessa. Abilitala qui sotto, poi riapri Cleankey."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение «%@» не предоставлено. Включите его ниже, затем откройте Cleankey заново."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」が許可されていません。下で有効にしてから、Cleankeyを開き直してください。"
          }
        }
      }
    },
    "permissions.missing.multiple": {
      "comment": "Shown when both required permissions are missing. The arguments are their localized names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and %@ not granted. Enable both below, then reopen Cleankey."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und „%2$@“ sind nicht erlaubt. Unten aktivieren und Cleankey anschließend erneut öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations « %1$@ » et « %2$@ » n’ont pas été accordées. Autorisez-les ci-dessous, puis rouvrez Cleankey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han concedido los permisos «%1$@» y «%2$@». Actívalos abajo y vuelve a abrir Cleankey."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授予“%1$@”和“%2$@”权限。请在下方启用，然后重新打开 Cleankey。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le autorizzazioni “%1$@” e “%2$@” non sono state concesse. Abilitale qui sotto, poi riapri Cleankey."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешения «%1$@» и «%2$@» не предоставлены. Включите их ниже, затем откройте Cleankey заново."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」と「%2$@」が許可されていません。下で有効にしてから、Cleankeyを開き直してください。"
