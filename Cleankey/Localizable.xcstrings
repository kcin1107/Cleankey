            "value": "Проверить наличие обновлений…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを確認…"
          }
        }
      }
    },
    "Checking…": {
      "comment": "Informational status while checking for a newer release.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
