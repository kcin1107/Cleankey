    "loginItem.approval.current": {
      "comment": "Tells the user where to approve Cleankey as a login item in macOS 15 and later.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Cleankey in System Settings › General › Login Items & Extensions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleankey in Systemeinstellungen › Allgemein › Anmeldeobjekte & Erweiterungen erlauben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Cleankey dans Réglages Système › Général › Ouverture et extensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Cleankey en Ajustes del Sistema › General › Ítems de inicio y extensiones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”›“通用”›“登录项与扩展”中允许 Cleankey。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Cleankey in Impostazioni di Sistema › Generali › Elementi login ed estensioni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Cleankey в разделе «Системные настройки» › «Основные» › «Объекты входа и расширения»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」›「一般」›「ログイン項目と機能拡張」でCleankeyを許可してください。"
          }
        }
      }
    },
