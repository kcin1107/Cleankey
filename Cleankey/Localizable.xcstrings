    "Check for Updates…": {
      "comment": "Button that checks GitHub for a newer Cleankey release.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Updates suchen …"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher les mises à jour…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar actualizaciones…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
