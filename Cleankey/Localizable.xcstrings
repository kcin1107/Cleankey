        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを確認中…"
          }
        }
      }
    },
    "Cleankey is up to date!": {
      "comment": "Informational status shown when no newer release is available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleankey is up to date!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleankey ist auf dem neuesten Stand!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleankey est à jour !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Cleankey está actualizado!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleankey 已是最新版本！"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleankey è aggiornato!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установлена последняя версия Cleankey!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleankeyは最新の状態です！"
          }
        }
      }
    },
    "Couldn’t check for updates": {
      "comment": "Retry button shown when the update check fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check for updates"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Updates ist fehlgeschlagen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de mises à jour impossible"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposible buscar actualizaciones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查更新"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare la presenza di aggiornamenti"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбой проверки наличия обновлений"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを確認できません"
          }
        }
      }
    },
    "Couldn't lock the keyboard. Quit and reopen Cleankey, then try again.": {
      "comment": "Error shown when permissions appear granted but the event tap still requires an app relaunch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't lock the keyboard. Quit and reopen Cleankey, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur konnte nicht gesperrt werden. Cleankey beenden und erneut öffnen, dann noch einmal versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de verrouiller le clavier. Quittez et rouvrez Cleankey, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido bloquear el teclado. Sal de Cleankey, vuelve a abrir la app e inténtalo de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法锁定键盘。请退出并重新打开 Cleankey，然后再试一次。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile bloccare la tastiera. Esci e riapri Cleankey, quindi riprova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось заблокировать клавиатуру. Завершите Cleankey, откройте приложение снова и повторите попытку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードをロックできませんでした。Cleankeyを終了して開き直してから、もう一度お試しください。"
          }
        }
      }
    },
    "Quit Cleankey": {
      "comment": "Button that quits the application.",
      "extractionState": "manual",
      "localizations": {
        "en": {
