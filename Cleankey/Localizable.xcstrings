{
  "sourceLanguage": "en",
  "strings": {
    "Cleankey": {
      "comment": "Product name. Do not translate.",
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "Keyboard Cleaning": {
      "comment": "Title of the switch that locks the keyboard for cleaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard Cleaning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturreinigung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyage du clavier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpieza del teclado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘清洁"
          }
