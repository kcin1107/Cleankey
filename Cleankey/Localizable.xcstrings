          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードのクリーニング"
          }
        }
      }
    },
    "Open at Login": {
      "comment": "Title of the switch that launches Cleankey when the user logs in. Matches System Settings terminology.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Anmeldung öffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir avec la session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir al iniciar sesión"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时打开"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri al login"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать при входе"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に開く"
          }
        }
      }
    },
